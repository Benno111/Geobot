{
    "geode": "5.2.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "ios": "2.2081"
    },
    "version": "1.1.1",
    "id": "benno111.geobot",
    "name": "geobot",
    "developer": "Benno111",
    "description": "A macro bot and utility toolkit for Geometry Dash",
    "repository": "https://github.com/Benno111/geobot",
    "links": {
        "source": "https://github.com/Benno111/geobot",
        "homepage": "https://github.com/Benno111/geobot",
        "community": "https://discord.gg/w6yvdzVzBd"
    },
    "issues": {
        "info": "Report bugs and feature requests on the GitHub issue tracker.",
        "url": "https://github.com/Benno111/geobot/issues/new"
    },
    "dependencies": {
        "geode.node-ids": {
            "version": ">=1.23.0"
        }
    },
    "settings": {
        "feature_flag_frameperfect_detection": {
            "name": "Enable Frameperfect Detection",
            "description": "Turns the frameperfect detection system on or off.",
            "type": "bool",
            "default": false
        },
        "feature_flag_pathfinder": {
            "name": "Enable Pathfinder",
            "description": "Turns the pathfinder system on or off.",
            "type": "bool",
            "default": false
        },
        "pathfinder_solver_executable": {
            "name": "Pathfinder Solver Executable",
            "description": "Executable or script wrapper that generates a macro from a decompressed level string.",
            "type": "file",
            "default": {
                "win": "{gd_dir}/pathfinder.exe",
                "android": "",
                "ios": ""
            },
            "control": {
                "dialog": "open",
                "filters": [
                    {
                        "files": [
                            "*.exe",
                            "*.bat",
                            "*.cmd"
                        ],
                        "description": "Executable programs"
                    }
                ]
            }
        },
        "pathfinder_solver_args": {
            "name": "Pathfinder Solver Arguments",
            "description": "Arguments passed to the solver. Supported placeholders: {input}, {output}, {level_name}.",
            "type": "string",
            "default": "--input \"{input}\" --output \"{output}\" --name \"{level_name}\""
        },
        "pathfinder_output_folder": {
            "name": "Pathfinder Output Folder",
            "description": "Folder used for temporary level exports and generated pathfinder macros.",
            "type": "folder",
            "default": "{mod_save_dir}/pathfinder"
        }
    },
    "resources": {
        "sprites": [
            "resources/GJ_commentSide2_001_White.png",
            "resources/GJ_commentTop2_001_White.png"
        ],
        "files": [
            "about.md",
            "changelog.md",
            "support.md",
            "logo.png",
            "resources/default_hold_click.mp3",
            "resources/default_release_click.mp3",
            "resources/default_hold_left.mp3",
            "resources/default_release_left.mp3",
            "resources/default_hold_right.mp3",
            "resources/default_release_right.mp3"
        ]
    },
    "tags": [
        "gameplay",
        "utility",
        "cheat"
    ]
}
